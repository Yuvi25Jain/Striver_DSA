#include <iostream>
#include<bits/stdc++.h>
using namespace std;

//couunt no of digits
int count(int n){
    int cnt = 0 ;
    while(n>0){
       int  lstdigt = n%10;
        cnt++;
        n = n/10;
    }
    return cnt;
}

//reverse no
int revno(int n){
    int revn = 0 ;
    while(n>0){
        int lstdigt = n%10;
        n = n/10;
        revn = (revn*10)+lstdigt;
        
    }
    return revn;
}

//is palindrome
bool nopalindrome(int n){
   int ori = n ;
   int revn = revno(n);
   return(revn == ori);
}


//armstrong
bool armstrong(int n){
    int ori = n ;
    int sum = 0 ;
    int digits = 0, temp = n;
    while(temp > 0) {
        digits++;
        temp /= 10;
    }
    
    while(n>0){
        int lstdigt = n%10;
        sum += pow(lstdigt,digits);
        n = n/10;
    }
    return(sum == ori);
}

//print no of divisors
void divir(int n){
    for(int i = 1; i<=n ; i++){
        if(n%i == 0){
            cout<<i<<" ";
        }
    }
}

int main()
{
    int n ;
    cin>>n;
    cout<<"count no of digit: "<<count(n)<<endl;
    cout<<"reverse no: "<<revno(n)<<endl;
    cout<<"is palindrome: "<<(nopalindrome(n)?"true":"false")<<endl;
    cout<<"is armstrong: "<<(armstrong(n)?"true":"false")<<endl;
    cout<<"all divisors: "<<endl;
    divir(n);
    return 0;
}
