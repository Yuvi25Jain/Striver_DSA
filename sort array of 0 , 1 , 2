// ques : given unsorted arrays with three elements 0 , 1 , 2 . we need to sort them

//brute force: 3 individual counter for 0 , 1 , 2 . count them first then overwrite the original space. here tc is o(2n) but sc is 
// o(1) not using xtra space.

void sort_zero_brute(int a[], int n){
    int cnt_z = 0 , cnt_o = 0 , cnt_t = 0 ;
    for(int i = 0 ; i<n ; i++){
        if(a[i] == 0){
            cnt_z++;
        }
        else if(a[i] == 1){
            cnt_o++; 
        }
        else{
            cnt_t++;
        }
    }
    for(int i = 0 ; i < cnt_z ; i++){
        a[i] = 0 ;
    }
    for(int i = cnt_z ; i < cnt_z + cnt_o ; i++){
        a[i] = 1 ;
    } 
    for(int i = cnt_z + cnt_o ; i < n ; i++){
        a[i] = 2 ; 
    }
    
}

// optimal approach : dutch national flag algo . 3 pointers low , mid , high then condition 
/* 0 to low - 1 : all zeroes
    low to mid - 1 : all ones
    mid to high : unsorted 
    high +1  to n : all twoes
    
    
    if a[mid] == 0 then swap(a[mid], a[low]) then mid++ , low++ 
    if a[mid] == 1 then no swap then mid++ 
    if a[mid] == 2 then swap(a[mid], a[high]) then high --  
    
    terminate the loop once the mid cross high
    */

void sort_zero_optimal(int a[], int n){
    int low = 0 , mid = 0 , high = n-1 ;
    while(mid <= high){
        if(a[mid] == 0){
            swap(a[mid] , a[low]);
            mid++ ; 
            low++;
            
        }
        else if(a[mid] == 1){
            mid++;
        }
        else{
            high -- ;
        }
    }
    
}
