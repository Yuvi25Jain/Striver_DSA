void iarr(int a[][100], int n , int m){
    cout<<"Enter the array eleements: "<<endl;
    for(int i = 0 ; i<n ; i++){
        for(int j = 0 ; j<m ; j++){
            cin>>a[i][j];
        }
        
    }
}

void oarr(int a[][100], int n , int m){
    
    for(int i  = 0 ; i<n ; i++){
        for(int j = 0 ; j < m ; j++){
            cout<<a[i][j]<<" ";
        }
        cout<<endl;
    }
}


void rotatearr_brute(int a[][100], int n, int m){
    std::vector<std::vector<int>> newMat(m, std::vector<int>(n));

    for(int i = 0 ; i<n ; i++){
        for(int j = 0 ; j<m ; j++){
            newMat[j][n-1-i] = a[i][j];
        }
    }
    cout<<"Rotated is: "<<endl;
    for (int i = 0; i < m; i++) {
    for (int j = 0; j < n; j++) {
        cout << newMat[i][j] << " ";
    }
    std::cout << std::endl;
}

    
}




int main()
{
    const int M = 4, N = 4;
int a[M][100];

    iarr(a,M,N);
    cout<<"You have entered the following elements: "<<endl;
    oarr(a,M,N);
    rotatearr_brute(a,M,N);
    

    return 0;
}
