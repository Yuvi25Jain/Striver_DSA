bool check(vector<int>& a) {
        int n = a.size();
        int countDrops = 0;

    for (int i = 0; i < n; i++) {
        int next = a[(i+1) % n];
        if (a[i] > next) {
            countDrops++;
        }
    }
    return countDrops <= 1;  // allow exactly one drop
      
