void movezero(int a[], int n){
    int temp[n];
    int idx = 0 ;
    for(int i = 0 ; i < n ; i++){
        if(a[i] != 0){
            temp[idx] = a[i];
            idx++ ;
        }
    }
    while (idx < n) {
        temp[idx] = 0;
        idx++;
    }

    // Copy back to original array
    for (int i = 0; i < n; i++) {
        a[i] = temp[i];
    }
}

void movezero_optimised(int a[], int n) {
    int nonZeroIndex = 0;
    for (int i = 0; i < n; i++) {
        if (a[i] != 0) {
            swap(a[nonZeroIndex], a[i]);
            nonZeroIndex++;
        }
    }
}

