// way 2 : list

// Input function: builds adjacency list
void igl(int n, int m, vector<int> adj[]) {
    for (int i = 0; i < m; i++) {
        int u, v;
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);   // remove this line if graph is directed
    }
}

// Output function: prints adjacency list
void ogl(int n, vector<int> adj[]) {
    cout << "Adjacency List:\n";
    for (int i = 1; i <= n; i++) {   // one-based indexing
        cout << i << " -> ";
        for (int v : adj[i]) {
            cout << v << " ";
        }
        cout << endl;
    }
}

