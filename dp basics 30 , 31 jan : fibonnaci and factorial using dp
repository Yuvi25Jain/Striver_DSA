//dp : memoization :  recursion to dp : tc = o(n) and sc = o(n) + o(n) (for extra array)
//dp me 3 ways to solve problem i.e 1. memoization , tabuation , space optmisation
int fib(int n , vector<int>& dp){
    if(n<=1){
        return n ; //base condtion
    }
    if(dp[n] != -1){
        return dp[n];
    }
    else{
        return dp[n] = fib(n-1,dp) + fib(n-2,dp);
    }
}

//dp method 2 : tabularization

int fib_table(int n , vector<int>& dp){
    dp[0] = 0 , dp[1] = 1 ;
    for(int i = 2 ; i<=n ; i++){
        dp[i] = dp[i-1] + dp[i-2];
    }
    return dp[n];
}

//dp method 3 : space optimised ... no array

int fib_space(int n , vector<int>& dp){
    int prev2 = 0 , prev = 1 ;
    int curri  ;
    for(int i = 2 ; i<=n ; i++){
        curri = prev2 + prev;
        prev2 = prev ;
        prev = curri ;
        
    }
    return prev;
}

