//optimal : dutch national flag algorithm . it have 3 ptr named as left , mid and right. see copy to check its condition


void sort(vector<int>& a, int n) {
    int left = 0, mid = 0, high = n - 1;
    while (mid <= high) {
        if (a[mid] == 0) {
            swap(a[mid], a[left]);
            left++;
            mid++;
        } else if (a[mid] == 1) {
            mid++;
        } else {
            swap(a[mid], a[high]);
            high--;
        }
    }
}

void print(const vector<int>& a) {
    for (int i = 0; i < a.size(); i++) {
        cout << a[i] << " ";
    }
    cout << endl; // Add a newline for better output formatting
}

int main() {
    vector<int> a = {0, 1, 1, 0, 1, 2, 1, 2, 0, 0, 0};
    sort(a, a.size());
    print(a);
    return 0;
}
