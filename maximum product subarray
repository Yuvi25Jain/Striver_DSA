/*optimal : o(n) observation intutive, calculate prefix , suffix , if 0 element then reset pref or suff*/
int maxpro_optimal(vector<int> &a){
   int n = a.size();
   int ans = INT_MIN;
   int prefix = 1 , suffix = 1 ;
   for(int i = 0 ; i<n ; i++){
       
       //handling edge case if 0 element is there
       if(prefix == 0){
           prefix = 1 ;
       }
       if(suffix == 0){
           suffix = 1 ;
       }
       prefix = prefix* a[i];
       suffix = suffix*a[n-1-i];
       ans = max(ans , max(prefix, suffix));
   }
   return ans; 
    
}



int main()
{
    vector<int> a = {2,3,-2,4};
    int ans = maxpro_optimal(a);
    cout<<"Max product : "<<ans<<endl;
    return 0;
}
