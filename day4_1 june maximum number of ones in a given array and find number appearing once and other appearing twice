//find maximum number of consecutive ones

int maxones(int a[], int n)
{
    int maxi = 0, cnt = 0;
    for (int i = 0; i < n; i++)
    {
        if (a[i] == 1)
        {
            cnt++;
            maxi = max(maxi, cnt);
        }
        else
        {
            cnt = 0; // Reset count when a 0 is encountered
        }
    }
    return maxi;
}

