//optimised solution : two ways . 1. sum of N natural number - sum of all elements in an array . 2. XOR

int missing(int a[] , int n){
    int N = n + 1;
    int sum = (N * (N + 1)) / 2; // Corrected multiplication
    int s2 = 0;
    for (int i = 0; i < n; i++) {
        s2 += a[i];
    }
    return (sum - s2);
}

