/*optimal : start from end */

vector<int> leaderelemt(vector<int>& a){
    vector<int> ans;
    int n = a.size();
    int maxi = INT_MIN;
    for(int i = n-1 ; i>= 0 ; i--){
        if(a[i] >  maxi){
            ans.push_back(a[i]);
        }
        maxi = max(maxi , a[i]);
    }
    
    
    // answer want sorted array.
    sort(ans.begin(), ans.end());
    return ans;
}

