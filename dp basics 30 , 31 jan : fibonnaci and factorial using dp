int fact_mem(int n , vector<int>& dp){
    if (n == 0 || n == 1){
        return 1 ; 
    }
    if(dp[n] != -1){
        return dp[n];
    }
    else{
         return dp[n] = n*fact_mem(n-1,dp);
    }
}

